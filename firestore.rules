rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/estimates/{estimateId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          'quantity', 'groups', 'result', 'allocations', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'quantity', 'groups', 'result', 'allocations', 'createdAt'
        ])
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.groups is list
        && request.resource.data.result is map
        && request.resource.data.allocations is list
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Retired shared history: it is not readable or writable by app clients.
    match /calculationHistory/{estimateId} {
      allow read, write: if false;
    }
  }
}
